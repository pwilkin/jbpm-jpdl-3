<project>

  <!-- ================================================================== -->
  <!-- jBPM Database schema                                               -->
  <!-- ================================================================== -->

  <target name="setup-schema">

    <!-- echo message="${maven.runtime.classpath}"/ -->
      
    

    <property name="scriptsdir" value="${basedir}/target/classes"/>
    <mkdir dir="${scriptsdir}"/>

  </target>

  <target name="create-schema" depends="setup-schema" description="Generate jBPM Database Schemas">

    <java classname="org.jbpm.db.JbpmSchema" fork="true">
      <arg value="create"/>
      <arg value="hibernate.cfg.db2.xml"/>
      <classpath path="${maven.runtime.classpath}"/>
    </java>
    <java classname="org.jbpm.db.JbpmSchema" fork="true">
      <arg value="create"/>
      <arg value="hibernate.cfg.derby.xml"/>
      <classpath path="${maven.runtime.classpath}"/>
    </java>
    <java classname="org.jbpm.db.JbpmSchema" fork="true">
      <arg value="create"/>
      <arg value="hibernate.cfg.firebird.xml"/>
      <classpath path="${maven.runtime.classpath}"/>
    </java>
    <java classname="org.jbpm.db.JbpmSchema" fork="true">
      <arg value="create"/>
      <arg value="hibernate.cfg.hsqldb.xml"/>
      <classpath path="${maven.runtime.classpath}"/>
    </java>
    <java classname="org.jbpm.db.JbpmSchema" fork="true">
      <arg value="create"/>
      <arg value="hibernate.cfg.ingres.xml"/>
      <classpath path="${maven.runtime.classpath}"/>
    </java>
    <java classname="org.jbpm.db.JbpmSchema" fork="true">
      <arg value="create"/>
      <arg value="hibernate.cfg.interbase.xml"/>
      <classpath path="${maven.runtime.classpath}"/>
    </java>
    <java classname="org.jbpm.db.JbpmSchema" fork="true">
      <arg value="create"/>
      <arg value="hibernate.cfg.mckoi.xml"/>
      <classpath path="${maven.runtime.classpath}"/>
    </java>
    <java classname="org.jbpm.db.JbpmSchema" fork="true">
      <arg value="create"/>
      <arg value="hibernate.cfg.mssql.xml"/>
      <classpath path="${maven.runtime.classpath}"/>
    </java>
    <java classname="org.jbpm.db.JbpmSchema" fork="true">
      <arg value="create"/>
      <arg value="hibernate.cfg.mysql.xml"/>
      <classpath path="${maven.runtime.classpath}"/>
    </java>
    <java classname="org.jbpm.db.JbpmSchema" fork="true">
      <arg value="create"/>
      <arg value="hibernate.cfg.oracle.xml"/>
      <classpath path="${maven.runtime.classpath}"/>
    </java>
    <java classname="org.jbpm.db.JbpmSchema" fork="true">
      <arg value="create"/>
      <arg value="hibernate.cfg.postgresql.xml"/>
      <classpath path="${maven.runtime.classpath}"/>
    </java>
    <java classname="org.jbpm.db.JbpmSchema" fork="true">
      <arg value="create"/>
      <arg value="hibernate.cfg.sapdb.xml"/>
      <classpath path="${maven.runtime.classpath}"/>
    </java>
    <java classname="org.jbpm.db.JbpmSchema" fork="true">
      <arg value="create"/>
      <arg value="hibernate.cfg.sybase.xml"/>
      <classpath path="${maven.runtime.classpath}"/>
    </java>
   
    <!--[JBPM-1813] Fix create schema generation -->
    <!--jbpmschema output="${scriptsdir}/jbpm.jpdl.informix.sql" config="hibernate.cfg.informix.xml" action="create"/-->
    <!--jbpmschema output="${scriptsdir}/jbpm.jpdl.pointbase.sql" config="hibernate.cfg.pointbase.xml" action="create"/-->
    <!--jbpmschema output="${scriptsdir}/jbpm.jpdl.progress.sql" config="hibernate.cfg.progress.xml" action="create"/-->
   
  </target>
  
  <target name="update-schema" depends="setup-schema" description="Generate jBPM Database Update Scripts">
  
    <java classname="org.jbpm.db.JbpmSchema" fork="true">
      <arg value="scripts"/>
      <arg value="${scriptsdir}"/>
      <arg value="jbpm.jpdl.mysql"/>
      <arg value="hibernate.cfg.mysql.xml"/>
      <arg value="mysql.properties"/>
      <classpath path="${maven.runtime.classpath}"/>
    </java>
    <java classname="org.jbpm.db.JbpmSchema" fork="true">
      <arg value="scripts"/>
      <arg value="${scriptsdir}"/>
      <arg value="jbpm.jpdl.sybase"/>
      <arg value="hibernate.cfg.sybase.xml"/>
      <arg value="sybase.properties"/>
      <classpath path="${maven.runtime.classpath}"/>
    </java>
   
  </target>
  
</project>
